{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@bkny/sim": ["./packages/sim/src/index.ts"],
      "@bkny/netcode": ["./packages/netcode/src/index.ts"]
    }
  },
  "include": ["packages", "apps", "vitest.config.ts"]
}
